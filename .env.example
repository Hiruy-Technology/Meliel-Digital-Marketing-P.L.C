# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Site (used from the design phase on)
# ---------------------------------------------------------------------------

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which environment this is: development | preview | production
# "preview" shows the design-preview banner and blocks search engines (robots noindex).
NEXT_PUBLIC_SITE_ENV=development

# ---------------------------------------------------------------------------
# Analytics (phase 3)
# ---------------------------------------------------------------------------

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (the content of the meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Payload CMS + database
# ---------------------------------------------------------------------------

# Postgres connection string. Local value below is the docker-compose database (pnpm db:up).
# Production: the Neon connection string.
DATABASE_URL=postgres://meliel:meliel_dev@localhost:5435/meliel

# Long random string used by Payload to sign sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# ---------------------------------------------------------------------------
# Media storage: Cloudflare R2, S3-compatible (phase 3, production only)
# ---------------------------------------------------------------------------

R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL that serves the bucket's files, e.g. https://media.example.com
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Email notifications: Resend (phase 3)
# ---------------------------------------------------------------------------

RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Meliel Website <noreply@example.com>"
INQUIRY_FROM_EMAIL=
# Comma-separated list of Meliel team addresses that receive new inquiries
INQUIRY_TO_EMAILS=

# ---------------------------------------------------------------------------
# AI Case Study Writer: Anthropic API (phase 3)
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
